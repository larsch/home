{
    "layer": "bottom",
    "position": "bottom",
    "modules-left": [
        // "sway/workspaces",
        // "sway/mode",
        "niri/workspaces"
    ],
    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "󰝚",
            "6": "",
            "7": "󱓧",
            "default": ""
        },
        "max-length": 30,
        "max-length-ellipsis": true,
        "max-length-ellipsis-text": "...",
        "max-length-ellipsis-text-urgent": "!!"
    },
    "modules-center": [
        "niri/window"
    ],
    "modules-right": [
        "idle_inhibitor",
        "custom/homevpn",
        "custom/powerprofile",
        "custom/bluetooth",
        "wireplumber#sink",
        "wireplumber#source",
        "network",
        // "custom/speed",
        "cpu",
        "custom/gpu_power",
        "custom/gpu_temp",
        "memory",
        // "temperature",
        "custom/cpu_temp",
        "custom/turbostat",
        "battery",
        "custom/ports",
        "custom/disks",
        "custom/weather",
        "tray",
        "clock"
    ],
    "wlr/taskbar": {
        "format": "{icon} {title}",
        "format-icons": {
            "default": "",
            "urgent": ""
        },
        "max-length": 30,
        "max-length-ellipsis": true,
        "max-length-ellipsis-text": "...",
        "max-length-ellipsis-text-urgent": "!!"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "󰝚",
            "6": "",
            "7": "󱓧",
            "urgent": "",
            "default": ""
        }
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "idle_inhibitor": {
        "format": "{icon} ",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        // "icon-size": 21,
        "spacing": 4
    },
    "clock": {
        // "timezone": "America/New_York",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "custom/cpu_temp": {
        "format": "{}°C {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        // "exec": "sensors -j 2>/dev/null | jq '.[\"nct6798-isa-0290\"].CPUTIN.temp2_input | round'",
        "exec": "sensors -j 2>/dev/null | jq '(.[\"nct6798-isa-0290\"].CPUTIN.temp2_input // .[\"k10temp-pci-00c3\"].Tctl.temp1_input) | round'",
        "interval": 1
    },
    "backlight": {
        "format": "{percent}% {icon}",
        "format-icons": [
            "",
            ""
        ]
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "interval": 2,
        "format": "{power:.2}W {capacity}% {icon}",
        "format-charging": "{power:.2}W {capacity}% 󰂐",
        "format-plugged": "{power:.2}W {capacity}% ",
        "format-alt": "{power:.2}W {time} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ifname}: {ipaddr}/{cidr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },
    "wireplumber#sink": {
        "format": "{volume}% {icon}",
        "format-muted": "",
        "format-icons": [
            "",
            "",
            ""
        ],
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "wireplumber#source": {
        "node-type": "Audio/Source",
        "format": "{volume}% ",
        "format-muted": "",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "scroll-step": 5
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pavucontrol"
    },
    "custom/homevpn": {
        "format": "{text} {icon}",
        "format-icons": {
            "connected": "󰤨",
            "disconnected": "󰤭"
        },
        "exec": "/home/larsch/.config/waybar/waybar-homevpn",
        "return-type": "json",
        "interval": 2,
        "on-click": "/home/larsch/bin/homevpn-toggle"
    },
    "custom/powerprofile": {
        "format": "{text} {icon}",
        "format-icons": {
            "performance": "󰒋",
            "balanced": "󰒉",
            "power-saver": "󰒊"
        },
        "exec": "/home/larsch/.config/waybar/waybar-powerprofile",
        "return-type": "json",
        "interval": 2
    },
    "custom/weather": {
        "format": "{}",
        "exec": "$HOME/.cargo/bin/weatherbar",
        "interval": 300, // 5 minutes
        "return-type": "json"
    },
    "custom/ports": {
        "format": "{} 󰙜",
        "exec": "$HOME/.config/waybar/waybar-ports"
    },
    "custom/disks": {
        "format": "{} 󰋊",
        "exec": "$HOME/.config/waybar/waybar-drives"
    },
    "custom/turbostat": {
        "format": "{:.4}W 󱪂",
        "exec": "sudo turbostat --Summary --quiet --show PkgWatt --interval 5"
    },
    "custom/bluetooth": {
        "format": "{text} {icon}",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "exec": "$HOME/.config/waybar/waybar-bluetooth",
        "return-type": "json",
        "interval": 60
    },
    "custom/speed": {
        "exec": "$HOME/.config/waybar/waybar-speed",
        "interval": 1,
        "return-type": "json"
    },
    "custom/gpu_power": {
        "format": "{text}W ",
        "exec": "/home/larsch/.config/waybar/waybar-gpu-power",
        "interval": 1,
        "return-type": "json"
    },
    "custom/gpu_temp": {
        "format": "{text}°C {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "exec": "/home/larsch/.config/waybar/waybar-gpu-temp",
        "interval": 1,
        "return-type": "json"
    }
}

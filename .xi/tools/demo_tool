#!/usr/bin/env python3
"""
demo_tool — a minimal tau custom tool demo.

Protocol:
  --describe   Print JSON descriptor and exit 0.
  (stdin)      Receive JSON args object, print result to stdout.
"""

import json
import sys

DESCRIPTOR = {
    "name": "demo_tool",
    "description": (
        "A demo tool that reverses a string and reports its length. "
        "Useful for verifying that custom tool loading works correctly."
    ),
    "parameters_schema": {
        "type": "object",
        "properties": {
            "text": {
                "type": "string",
                "description": "The text to process.",
            }
        },
        "required": ["text"],
    },
}


def main() -> None:
    if len(sys.argv) > 1 and sys.argv[1] == "--describe":
        print(json.dumps(DESCRIPTOR))
        return

    raw = sys.stdin.read()
    try:
        args = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(f"error: could not parse args JSON: {exc}", file=sys.stderr)
        sys.exit(1)

    text = args.get("text")
    if not isinstance(text, str):
        print("error: 'text' must be a string", file=sys.stderr)
        sys.exit(1)

    reversed_text = text[::-1]
    length = len(text)

    result = {
        "original": text,
        "reversed": reversed_text,
        "length": length,
    }
    print(json.dumps(result, indent=2))


if __name__ == "__main__":
    main()

#!/usr/bin/env python3
import fcntl
import json
import os
import subprocess
import sys
import time
from urllib.error import URLError
from urllib.request import urlopen

PROJECT = "/home/larsch/prj/retrieve"
SEARXNG_PROJECT = "/home/larsch/prj/searxng"
SEARXNG_URL = "http://localhost:8080/healthz"
STARTUP_TIMEOUT = 60

DESCRIPTOR = {
    "name": "web-search",
    "description": "Search the local SearXNG instance and return raw JSON results.",
    "parameters_schema": {
        "type": "object",
        "properties": {"query": {"type": "string", "description": "Search query."}},
        "required": ["query"],
        "additionalProperties": False,
    },
}


def _searxng_ready() -> bool:
    try:
        with urlopen(SEARXNG_URL, timeout=0.5) as response:
            return response.status == 200
    except (OSError, URLError):
        return False


def _ensure_searxng() -> bool:
    # Serialize startup checks across tool invocations. A later caller rechecks
    # readiness while holding the lock, so it won't restart or wait on a healthy
    # instance after another caller has started it.
    lock_path = os.path.join(
        os.environ.get("XDG_RUNTIME_DIR", "/tmp"),
        f"searxng-web-search-{os.getuid()}.lock",
    )
    try:
        lock = open(lock_path, "a")
    except OSError as exc:
        print(f"cannot open SearXNG startup lock: {exc}", file=sys.stderr)
        return False

    with lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if _searxng_ready():
            return True

        try:
            start = subprocess.run(
                ["podman", "compose", "up", "-d"],
                cwd=SEARXNG_PROJECT,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                check=False,
                timeout=STARTUP_TIMEOUT,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"could not start SearXNG: {exc}", file=sys.stderr)
            return False
        if start.returncode != 0:
            if start.stdout:
                sys.stderr.write(start.stdout)
            if start.stderr:
                sys.stderr.write(start.stderr)
            print("failed to start the SearXNG Compose services", file=sys.stderr)
            return False

        deadline = time.monotonic() + STARTUP_TIMEOUT
        while True:
            if _searxng_ready():
                return True
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                print(
                    f"SearXNG did not become ready within {STARTUP_TIMEOUT} seconds",
                    file=sys.stderr,
                )
                return False
            time.sleep(min(0.2, remaining))


def main() -> int:
    if sys.argv[1:] == ["--describe"]:
        print(json.dumps(DESCRIPTOR))
        return 0

    try:
        args = json.load(sys.stdin)
        query = args["query"]
        if not isinstance(query, str):
            raise TypeError("query must be a string")
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        print(f"invalid tool input: {exc}", file=sys.stderr)
        return 2

    if not _ensure_searxng():
        return 1

    result = subprocess.run(
        ["uv", "run", "--project", PROJECT, "search", query],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    return result.returncode


if __name__ == "__main__":
    raise SystemExit(main())
